APP_ENV=development            # development | staging | production
SECRET_KEY=change-me           # python -c "import secrets;print(secrets.token_urlsafe(50))"
DATABASE_URL=postgres://landed:landed@localhost:5432/landed   # empty = SQLite
REDIS_URL=                     # empty = background jobs run inline
PUBLIC_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

PAYMENT_PROVIDER=mock          # mock (test mode) | paystack
PAYSTACK_SECRET_KEY=           # Landed's own key: sk_test_... then sk_live_...
PAYSTACK_DVA_BANK=test-bank    # wema-bank or titan-paystack in live mode
LANDED_FEE_PERCENT=1.0         # Landed's cut of each payment
PAYSTACK_FEE_BEARER=subaccount # who pays Paystack's fee: subaccount (seller) or account (Landed)
PAY_LINK_HOURS=8               # how long a one-time account stays open (Paystack allows up to 8)

WHATSAPP_DRY_RUN=true
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

EMBED_SCHEDULER=false          # true on single-instance hosting without a Celery worker
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
