# ---- copy to .env and fill in ----
APP_NAME=Landed
# development | production   (production refuses to start with unsafe settings)
APP_ENV=development

# Public URLs. With docker compose locally both are http://localhost:8080 (nginx forwards /api, /r, /webhooks).
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Generate:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Comma-separate several to rotate: the first encrypts, all decrypt. Losing this = merchants must re-enter keys.
ENCRYPTION_KEYS=
# Header X-Admin-Token for /admin endpoints (our own support tools)
ADMIN_TOKEN=change-me-too
POSTGRES_PASSWORD=landed

# Test provider (simulated payments). MUST be false in production.
ALLOW_MOCK_PROVIDER=true
# Sandbox: https://sandbox.monnify.com   (merchants tick "live keys" in Settings to use https://api.monnify.com)
MONNIFY_BASE_URL=https://sandbox.monnify.com
DEFAULT_INVOICE_EXPIRY_DAYS=7
FREE_PLAN_INVOICE_CAP=50
RECONCILE_EVERY_HOURS=3

# WhatsApp Business Cloud API (Meta). Leave WHATSAPP_DRY_RUN=true to log messages instead of sending.
WHATSAPP_DRY_RUN=true
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en
